{
  "name": "stargaze",
  "private": true,
  "license": "AGPL-3.0-only",
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:cli": "esbuild cli/main.ts --bundle --platform=node --target=node22 --format=cjs --outfile=dist-node/cli.js --log-level=warning && node -e \"require('fs').writeFileSync('dist-node/package.json', JSON.stringify({type:'commonjs'}))\"",
    "build:server": "esbuild server/main.ts --bundle --platform=node --target=node22 --format=cjs --outfile=dist-node/server.js --log-level=warning",
    "serve": "npm run build && npm run build:cli && node dist-node/cli.js serve",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/montserrat": "^5.2.8",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.0.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "esbuild": "^0.28.1",
    "typescript": "^5.8.3",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  }
}
